{
  "manifest_version": 3,
  "name": "Work Radar — Work Capture & Priority Queue",
  "version": "1.0.0",
  "description": "Capture actionable work directly from any webpage into your live Work Radar Priority Queue.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Work Radar"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://work-radar-4hb0.onrender.com",
    "http://localhost:3000"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}