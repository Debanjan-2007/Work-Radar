# Server Configuration
PORT=3000
NODE_ENV=development
# Local: http://localhost:3000
# Render: https://YOUR-SERVICE.onrender.com  (Vercel is not required)
APP_URL=http://localhost:3000

# Security & Secrets
SESSION_SECRET=work-radar-super-secret-session-key-32-chars-min!
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# PostgreSQL Database (Supabase or Local PostgreSQL)
# Example: postgresql://postgres:password@localhost:5432/workradar
# If DATABASE_URL is not set or unreachable, Work Radar uses its resilient in-memory PostgreSQL engine for local development
DATABASE_URL=

# ── OAuth 2.0 Provider Credentials ─────────────────────────────────────────────
#
# IMPORTANT: For OAuth to work with non-test email accounts, you must either:
#   1. Add your email as a test user in each OAuth app's developer console, OR
#   2. Publish the OAuth app to production (verify/publish the app)
#
# GOOGLE (Gmail + account identity)
#   1. Go to https://console.cloud.google.com/  → APIs & Services → Credentials
#   2. Create an OAuth 2.0 Client ID (type: Web Application)
#   3. Add Authorized redirect URIs:
#      - Local: http://localhost:3000/api/v1/oauth/google/callback
#      - Render: https://YOUR-SERVICE.onrender.com/api/v1/oauth/google/callback
#   4. Enable APIs: Gmail API, Google+ API (or People API)
#   5. In OAuth consent screen, set to "Testing" and add your email as a test user,
#      OR publish the app to production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GITHUB (GitHub account + repository access)
#   1. Go to https://github.com/settings/developers → OAuth Apps → New OAuth App
#   2. Homepage URL: http://localhost:3000 (or your Render URL)
#   3. Authorization callback URL:
#      - Local: http://localhost:3000/api/v1/oauth/github/callback
#      - Render: https://YOUR-SERVICE.onrender.com/api/v1/oauth/github/callback
#   4. GitHub OAuth apps are automatically in production, no test user restriction
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# MICROSOFT (Outlook / Teams / Microsoft 365)
#   1. Go to https://portal.azure.com/ → Azure Active Directory → App registrations → New registration
#   2. Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
#   3. Redirect URIs (Web):
#      - Local: http://localhost:3000/api/v1/oauth/microsoft/callback
#      - Render: https://YOUR-SERVICE.onrender.com/api/v1/oauth/microsoft/callback
#   4. Under API Permissions, add: User.Read, Mail.Read (Microsoft Graph, Delegated)
#   5. Create a Client Secret under Certificates & Secrets
#   6. In the app registration, go to "Authentication" and ensure your account is added as a test user,
#      OR change the app to production in the "Overview" section
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# AI Integration (Optional - intelligent heuristic NLP extraction works out of the box)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Quiet Hours (24h format)
QUIET_HOURS_START=22
QUIET_HOURS_END=8

